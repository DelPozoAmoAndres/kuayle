DATABASE_URL=postgres://kuayle:kuayle@localhost:5432/kuayle?sslmode=disable
REDIS_URL=redis://localhost:6379
JWT_SECRET=local_dev_jwt_secret_32_chars_minimum_do_not_use_prod
PORT=8080
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
SYSADMINS=a0000000-0000-0000-0000-000000000001
PUBLIC_DEMO_MODE=true

# Storage (default: local filesystem)
# STORAGE_TYPE=local
# STORAGE_LOCAL_DIR=./uploads
# STORAGE_LOCAL_URL=/uploads

# GitHub App (optional — shared app across all workspaces)
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_WEBHOOK_URL=

# Gitea integration
# GITEA_ENABLED=true
# GITEA_DEFAULT_URL=
